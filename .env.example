# ── Required ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# ── Core ────────────────────────────────────────────────────────────────────
# Public origin the app is reached at (cookies, links in notifications).
APP_URL=http://localhost:3001
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=/data/app.db
# Comma-separated list of allowed browser origins (usually = APP_URL).
TRUSTED_ORIGINS=http://localhost:3001
TRUST_PROXY=false
LOG_LEVEL=info

# ── GitHub ──────────────────────────────────────────────────────────────────
# Fallback token used when a project has no token of its own. A fine-grained
# PAT with contents:read/write + pull_requests:write on selected repos is
# recommended.
GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# ── Scanning ────────────────────────────────────────────────────────────────
SCAN_CONCURRENCY=3
# NPM_REGISTRY_URL=https://registry.npmjs.org
# OSV_API_URL=https://api.osv.dev
# DISABLE_OSV=false
# Regenerate lockfiles in PRs (needs npm in the image; on by default).
ENABLE_LOCKFILE_REGEN=true

# ── Optional: encryption key rotation ───────────────────────────────────────
# Set to the OLD key while re-sealing after rotating APP_ENCRYPTION_KEY.
# APP_ENCRYPTION_KEY_PREVIOUS=

# ── Optional: observability ─────────────────────────────────────────────────
# METRICS_ENABLED=false
# METRICS_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Optional: update check ──────────────────────────────────────────────────
# Polls the GitHub releases feed twice a day and shows a notice in the UI
# when a newer version exists. Set to false for air-gapped installs.
# UPDATE_CHECK=true
