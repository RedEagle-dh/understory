{
	"name": "@declarativejs/module-observability",
	"version": "0.0.1",
	"description": "Optional observability module: OpenTelemetry tracing (Bun-safe) + Prometheus metrics. Not installed => the core runs on no-op telemetry.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"default": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@declarativejs/core": "workspace:*",
		"@declarativejs/logger": "workspace:*",
		"prom-client": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
